# Backend
DATABASE_URL=postgres://user:password@localhost:5432/slicer_labeler?sslmode=disable
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Object Storage (S3-compatible)
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_BUCKET=slicer-labeler
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_PREFIX=processing

# 认证（本地/内网开发：DEV_MODE=1 免 GitHub；生产 DEV_MODE=0 必填 GitHub 三参数）
DEV_MODE=1
JWT_SECRET=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/callback
PUBLIC_URL=http://localhost:8080


# Server
PORT=8080
HOST=0.0.0.0
